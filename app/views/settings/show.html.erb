<% content_for :page_title, "Settings" %>

<div class="max-w-2xl bg-white rounded-xl border border-slate-200 p-8 shadow-sm">
  <h2 class="text-xl font-bold text-slate-800 mb-1">API & Model Configurations</h2>
  <p class="text-sm text-slate-500 mb-6">Specify OpenAI credentials and default inference temperatures loaded in the environment.</p>

  <div class="space-y-6">
    <div>
      <label class="block text-xs font-bold text-slate-705 uppercase tracking-wider mb-2">OpenAI API Key</label>
      <div class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm font-mono">
        <% if @config.openai_api_key.present? %>
          <span class="text-green-600 font-semibold">● Configured</span>
        <% else %>
          <span class="text-red-500 font-semibold">● Not Configured</span>
        <% end %>
      </div>
      <span class="text-xs text-slate-400 mt-1 block">Loaded securely via environment file (.env). To override, set values in .env.</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label class="block text-xs font-bold text-slate-705 uppercase tracking-wider mb-2">Default Model</label>
        <div class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-600">
          <%= @config.default_model %>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-705 uppercase tracking-wider mb-2">Temperature</label>
        <div class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-600">
          <%= @config.default_temperature %>
        </div>
      </div>
    </div>

    <div class="pt-6 border-t border-slate-100 flex justify-between items-center">
      <div class="text-xs text-slate-400">
        Provider: <span class="font-semibold text-slate-600"><%= @config.provider.to_s.titleize %></span>
        &middot; Timeout: <span class="font-semibold text-slate-600"><%= @config.timeout %>s</span>
        &middot; Max Tokens: <span class="font-semibold text-slate-600"><%= @config.max_tokens %></span>
      </div>
      <button type="button"
              class="px-5 py-2.5 bg-indigo-600 text-white rounded-lg text-sm font-semibold hover:bg-indigo-750 transition-colors shadow-lg shadow-indigo-600/10 cursor-not-allowed opacity-80"
              disabled>
        Saved in Environment Mode
      </button>
    </div>
  </div>
</div>
