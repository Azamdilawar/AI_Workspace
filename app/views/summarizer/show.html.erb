<% content_for :page_title, "Summarizer" %>

<div class="max-w-5xl mx-auto"
     data-controller="summarizer"
     data-action="keydown.cmd+enter->summarizer#submit keydown.ctrl+enter->summarizer#submit">

  <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">

    <!-- Left Side: Form -->
    <div class="lg:col-span-2 space-y-6">
      <div>
        <h2 class="text-lg font-bold text-slate-800 tracking-tight">Input</h2>
        <p class="text-sm text-slate-500 mt-0.5">Paste or type the text you want to summarize.</p>
      </div>

      <%= form_with url: summarizer_path, method: :post,
            html: { data: { summarizer_target: "form", action: "submit->summarizer#submit" } },
            class: "space-y-5" do |f| %>

        <!-- Summary Type -->
        <div>
          <%= f.label :summary_type, "Summary Type", class: "block text-sm font-semibold text-slate-700 mb-1.5" %>
          <%= f.select :summary_type,
                options_for_select([
                  ["General Summary", "general"],
                  ["Bullet Points", "bullets"],
                  ["Executive Summary", "executive"],
                  ["Key Takeaways", "takeaways"],
                  ["Action Items", "actions"]
                ], "general"),
                {},
                class: "w-full px-3 py-2.5 bg-white border border-slate-200 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" %>
        </div>

        <!-- Length -->
        <div>
          <%= f.label :length, "Length", class: "block text-sm font-semibold text-slate-700 mb-1.5" %>
          <%= f.select :length,
                options_for_select([
                  ["Short", "short"],
                  ["Medium", "medium"],
                  ["Long", "long"]
                ], "medium"),
                {},
                class: "w-full px-3 py-2.5 bg-white border border-slate-200 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" %>
        </div>

        <!-- Tone -->
        <div>
          <%= f.label :tone, "Tone", class: "block text-sm font-semibold text-slate-700 mb-1.5" %>
          <%= f.select :tone,
                options_for_select([
                  ["Neutral", "neutral"],
                  ["Professional", "professional"],
                  ["Simple", "simple"]
                ], "neutral"),
                {},
                class: "w-full px-3 py-2.5 bg-white border border-slate-200 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" %>
        </div>

        <!-- Text Input -->
        <div>
          <%= f.label :text, "Text to Summarize", class: "block text-sm font-semibold text-slate-700 mb-1.5" %>
          <%= f.text_area :text,
                placeholder: "Paste the article, document, or text you want to summarize here...",
                rows: 12,
                data: { summarizer_target: "input", controller: "autogrow" },
                class: "w-full px-4 py-3 bg-white border border-slate-200 rounded-lg text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 resize-none font-mono leading-relaxed" %>
        </div>

        <!-- Submit -->
        <%= f.submit "Generate Summary",
              data: { summarizer_target: "submit" },
              class: "w-full px-5 py-3 bg-indigo-600 text-white rounded-xl text-sm font-semibold hover:bg-indigo-700 transition-colors shadow-sm disabled:opacity-50 disabled:cursor-not-allowed" %>
      <% end %>
    </div>

    <!-- Right Side: Output -->
    <div class="lg:col-span-3 space-y-6">
      <div>
        <h2 class="text-lg font-bold text-slate-800 tracking-tight">Summary</h2>
        <p class="text-sm text-slate-500 mt-0.5">Your AI-generated summary will appear here.</p>
      </div>

      <!-- Loading Indicator -->
      <div data-summarizer-target="loading" class="hidden">
        <div class="bg-white border border-slate-200 rounded-xl p-8 shadow-sm">
          <div class="flex items-center gap-3 mb-4">
            <span class="w-2.5 h-2.5 bg-indigo-500 rounded-full animate-pulse"></span>
            <span class="text-sm font-medium text-slate-600">Generating summary...</span>
          </div>
          <div class="space-y-3">
            <div class="h-4 bg-slate-100 rounded-full w-3/4 animate-pulse"></div>
            <div class="h-4 bg-slate-100 rounded-full w-1/2 animate-pulse"></div>
            <div class="h-4 bg-slate-100 rounded-full w-5/6 animate-pulse"></div>
            <div class="h-4 bg-slate-100 rounded-full w-2/3 animate-pulse"></div>
            <div class="h-4 bg-slate-100 rounded-full w-4/5 animate-pulse"></div>
          </div>
        </div>
      </div>

      <!-- Error Message -->
      <div data-summarizer-target="error" class="hidden">
        <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl p-4 text-sm font-medium">
          <div class="flex items-center gap-2 mb-1">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
            </svg>
            <span class="font-semibold">Generation Failed</span>
          </div>
          <span data-summarizer-target="error"></span>
        </div>
      </div>

      <!-- Output Area -->
      <div data-summarizer-target="outputWrapper" class="hidden">
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
          <textarea data-summarizer-target="output"
                    data-controller="autogrow"
                    placeholder="Your summary will appear here..."
                    spellcheck="true"
                    class="w-full min-h-[300px] px-5 py-4 bg-white text-sm text-slate-700 font-mono leading-relaxed focus:outline-none focus:ring-2 focus:ring-inset focus:ring-indigo-500/20 focus:border-indigo-500 resize-y border-0"></textarea>

          <!-- Controls -->
          <div data-summarizer-target="controls" class="hidden border-t border-slate-100 px-5 py-3 bg-slate-50 flex items-center justify-between">
            <span class="text-xs text-slate-400">
              <span class="font-medium text-slate-500">Tip:</span> Edit the summary directly in the text area above.
            </span>
            <div class="flex items-center gap-2">
              <button data-action="click->summarizer#regenerate"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182" />
                </svg>
                Regenerate
              </button>
              <button data-action="click->summarizer#copy"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 hover:text-indigo-600 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
                </svg>
                Copy
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
