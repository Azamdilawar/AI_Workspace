<% content_for :page_title, "AI Chat" %>

<div class="flex h-full -m-8">
  <%= render "sidebar", conversations: @conversations %>

  <div class="flex-1 flex flex-col"
       data-controller="streaming"
       data-streaming-regenerate-url-value="<%= @conversation ? regenerate_conversation_messages_path(@conversation) : "" %>">
    <% if @conversation %>
      <div class="flex-1 overflow-y-auto px-6 py-4" data-streaming-target="messages" data-controller="chat">
        <%= render partial: "conversations/message", collection: @messages %>
      </div>
      <div class="border-t border-slate-200 bg-white px-6 py-4">
        <%= render "conversations/message_form", conversation: @conversation, message: @message %>
      </div>
    <% else %>
      <div class="flex-1 flex items-center justify-center">
        <div class="text-center">
          <div class="w-16 h-16 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-3xl font-bold mb-4 mx-auto">💬</div>
          <h2 class="text-xl font-bold text-black mb-2">Start a conversation</h2>
          <p class="text-black text-sm mb-6">Choose an existing conversation or create a new one.</p>
          <%= button_to conversations_path, method: :post, class: "inline-flex items-center gap-2 px-5 py-2.5 bg-blue-100 text-blue-900 border border-blue-400 rounded-lg text-sm font-semibold hover:bg-blue-200 transition-colors shadow-lg shadow-blue-600/10" do %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            New Chat
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
