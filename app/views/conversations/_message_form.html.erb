<%= form_with model: [conversation, message], url: conversation_messages_path(conversation),
      data: { action: "submit->streaming#submit" },
      class: "flex items-end gap-3" do |f| %>
  <div class="flex-1">
    <%= f.text_area :content,
          placeholder: "Type your message...",
          rows: 1,
          data: { streaming_target: "input", controller: "autogrow" },
          class: "w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 resize-none" %>
  </div>
  <%= f.submit "Send",
        data: { streaming_target: "submit" },
        class: "shrink-0 px-5 py-3 bg-indigo-600 text-white rounded-xl text-sm font-semibold hover:bg-indigo-700 transition-colors shadow-sm disabled:opacity-50 disabled:cursor-not-allowed" %>
<% end %>
