<div class="flex <%= message.role == "user" ? "justify-end" : "justify-start" %> mb-4">
  <div class="max-w-[75%] <%= message.role == "user" ?
        "bg-blue-600 text-white rounded-2xl rounded-br-md" :
        "bg-white border border-slate-200 text-black rounded-2xl rounded-bl-md" %> px-4 py-3 shadow-sm">
    <div class="text-sm leading-relaxed <%= message.role == "assistant" ? "prose prose-sm max-w-none prose-slate prose-headings:text-black prose-a:text-blue-600 prose-code:bg-slate-100 prose-code:px-1 prose-code:rounded prose-pre:bg-slate-900 prose-pre:text-slate-100 prose-pre:rounded-lg prose-pre:p-4 prose-code:before:content-none prose-code:after:content-none" : "whitespace-pre-wrap" %>">
      <%= message.role == "assistant" ? markdown(message.content) : message.content %>
    </div>
    <div class="mt-1 flex items-center gap-2 <%= message.role == "user" ? "text-blue-200" : "text-black" %> text-[10px] font-medium">
      <span><%= message.created_at.strftime("%I:%M %p") %></span>
      <% if message.token_count %>
        <span>&middot; <%= message.token_count %> tokens</span>
      <% end %>
      <% if message.role == "assistant" %>
        <span class="ml-auto inline-flex items-center gap-1">
          <button data-controller="copy" data-action="click->copy#copy" data-copy-value="<%= message.content %>" class="text-black hover:text-blue-600 transition-colors p-0.5 rounded" title="Copy response">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
            </svg>
          </button>
          <button data-action="click->streaming#regenerate" class="text-black hover:text-blue-600 transition-colors p-0.5 rounded" title="Regenerate response">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182" />
            </svg>
          </button>
        </span>
      <% end %>
    </div>
  </div>
</div>
