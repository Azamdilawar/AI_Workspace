<% content_for :page_title, "Knowledge Base" %>

<!-- Header -->
<div class="mb-8">
  <div class="bg-blue-900 rounded-2xl p-8 relative overflow-hidden border border-blue-800 shadow-xl shadow-blue-900/10">
    <div class="relative z-10 max-w-2xl">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-400/20 text-blue-200 font-medium text-xs mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
        Knowledge Base
      </div>
      <h2 class="text-3xl font-extrabold tracking-tight mb-2 text-blue-200">Documents</h2>
      <p class="text-blue-200 leading-relaxed text-sm">
        Manage your knowledge base. Upload documents to make them searchable and available for RAG.
      </p>
    </div>
    <div class="absolute right-0 bottom-0 opacity-10 blur-2xl w-64 h-64 bg-blue-500 rounded-full translate-x-12 translate-y-12"></div>
  </div>
</div>

<!-- Actions -->
<div class="mb-6">
  <%= link_to "Upload Document", new_knowledge_path, class: "px-4 py-2 bg-blue-100 text-blue-900 border border-blue-400 rounded-lg hover:bg-blue-200 font-semibold transition" %>
</div>

<!-- Documents List -->
<% if @knowledges.any? %>
  <div class="space-y-4">
    <% @knowledges.each do |knowledge| %>
      <div class="bg-white rounded-xl border border-slate-200 p-6 hover:border-blue-300 hover:shadow-md transition-all">
        <div class="flex items-start justify-between">
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-2">
              <h3 class="text-lg font-bold text-black">
                <%= link_to knowledge.title, knowledge_path(knowledge), class: "hover:text-blue-600 transition" %>
              </h3>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                <%= case knowledge.source_type
                    when 'manual' then 'bg-blue-100 text-blue-900'
                    when 'upload' then 'bg-green-100 text-green-900'
                    when 'url' then 'bg-purple-100 text-purple-900'
                    end %>">
                <%= knowledge.source_type.capitalize %>
              </span>
            </div>
            <p class="text-black text-sm line-clamp-2">
              <%= truncate(knowledge.content, length: 200) %>
            </p>
          </div>
          <div class="flex items-center gap-2 ml-4">
            <%= link_to knowledge_path(knowledge), class: "px-3 py-1.5 text-sm text-blue-600 hover:text-blue-800 font-medium transition" do %>
              View
            <% end %>
            <%= button_to knowledge_path(knowledge), method: :delete, class: "px-3 py-1.5 text-sm text-red-600 hover:text-red-800 font-medium transition", data: { turbo_confirm: "Are you sure?" } do %>
              Delete
            <% end %>
          </div>
        </div>
        <div class="mt-4 flex items-center gap-4 text-xs text-black">
          <span>Chunks: <strong class="text-blue-900"><%= knowledge.knowledge_chunks.count %></strong></span>
          <span>With embeddings: <strong class="text-blue-900"><%= knowledge.knowledge_chunks.with_embeddings.count %></strong></span>
          <span>Created: <strong class="text-blue-900"><%= knowledge.created_at.strftime("%b %d, %Y") %></strong></span>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-slate-50 border border-slate-200 rounded-xl p-8 text-center">
    <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-blue-100 flex items-center justify-center">
      <span class="text-3xl">📚</span>
    </div>
    <p class="text-black text-lg">No documents yet</p>
    <p class="text-black text-sm mt-2">Upload your first document to get started</p>
    <%= link_to "Upload Document", new_knowledge_path, class: "mt-4 inline-block px-4 py-2 bg-blue-100 text-blue-900 border border-blue-400 rounded-lg hover:bg-blue-200 font-semibold transition" %>
  </div>
<% end %>
